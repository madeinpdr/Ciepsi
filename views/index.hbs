    <div class="name-container">
      <div class="logo-name"></div>
    </div>
  </div>
  <div class="container-fluid vh-100 d-flex flex-column flex-md-row p-0">
    <div class="imagem-lateral d-none d-md-flex col-md-6 position-relative justify-content-center align-items-center">
      <div class="overlay"></div>
      <h2 class="texto-imagem position-absolute text-white">Simplifique a gestão da sua clínica</h2>
    </div>
    <div class="login-container d-flex justify-content-center align-items-center col-12 col-md-6 bg-white shadow">
      <div class="login-box text-center p-4 rounded-3">
        <img src="/img/logociepsi.png" alt="Logo Ciepsi+" class="logo mb-3" />
        <form id="login-form" method="POST" action="/auth/login">
          <div class="mb-3 text-start position-relative">
            <label for="email" class="form-label">E-mail</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="Digite seu e-mail" required oninput="validarFormulario()" />
          </div>
          <div class="mb-3 text-start position-relative">
            <label for="password" class="form-label">Senha</label>
            <input type="password" class="form-control" id="password" name="password" placeholder="Digite sua senha" required oninput="validarFormulario()" />
            <i class="bi bi-eye-slash position-absolute" id="btn-senha-login" onclick="mostrarSenha('password', 'btn-senha-login')" style="top: 60%; right: 15px; cursor: pointer;"></i>          </div>
          <button type="submit" id="submit-btn" class="btn btn-primary w-100" disabled>
            Entrar <i class="bi bi-box-arrow-in-right"></i>
          </button>
          <p class="mt-3 text-muted small">
            Ao entrar, você concorda com os 
            <a href="#" class="link-hover-primary text-decoration-underline">Termos de Uso</a> e com a 
            <a href="#" class="link-hover-primary text-decoration-underline">Política de Privacidade</a> do Ciepsi+.
          </p>
          <a href="#" class="esqueci-senha d-block mt-2 text-decoration-underline" onclick="mostrarRedefinicaoSenha()">Esqueci minha senha</a>
        </form>
        <div id="redefinir-senha-form" class="d-none text-start">
          <h5 class="mb-3 text-center">Redefina sua senha</h5>
          <p class="mb-4 text-center">Informe seu endereço de e-mail abaixo e enviaremos as instruções para redefinição de senha:</p>
          <div class="mb-3">
            <label for="reset-email" class="form-label">E-mail</label>
            <input type="email" class="form-control" id="reset-email" placeholder="Digite seu e-mail" required oninput="validarRedefinicaoSenha()" />
          </div>
          <button id="reset-btn" class="btn btn-primary w-100 mb-3" disabled>
            Redefinir senha <i class="bi bi-envelope-arrow-up"></i>
          </button>
          <div class="text-center">
            <a href="#" class="text-decoration-underline text-dark link-hover-primary small" onclick="voltarLogin()">Voltar para o login</a>
          </div>
        </div>
<div id="nova-senha-area" class="d-none">
  <label for="nova-senha" class="form-label">Nova Senha</label>
  <div class="position-relative">
    <input type="password" class="form-control" id="nova-senha" required />
    <i class="bi bi-eye-slash position-absolute" id="btn-senha-reset1" onclick="mostrarSenha('nova-senha', 'btn-senha-reset1')" style="top: 25%; right: 15px; cursor: pointer;"></i>
  </div>

  <label for="nova-senha-conf" class="form-label mt-2">Confirmar Nova Senha</label>
  <div class="position-relative">
    <input type="password" class="form-control" id="nova-senha-conf" required />
    <i class="bi bi-eye-slash position-absolute" id="btn-senha-reset2" onclick="mostrarSenha('nova-senha-conf', 'btn-senha-reset2')" style="top: 25%; right: 15px; cursor: pointer;"></i>
  </div>

  <button id="reset-pass-btn" class="btn btn-success w-100 mt-3">
    Salvar nova senha
  </button>
</div>

      </div>
    </div>
  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js"></script>
  <script>
    window.addEventListener("load", () => {
      gsap.to(".loading-page", {
        opacity: 0,
        duration: 1,
        delay: 2.5,
        onComplete: () => {
          document.querySelector(".loading-page").style.display = "none";
        },
      });
    });

    function mostrarSenha(inputId, eyeId) {
  const input = document.getElementById(inputId);
  const eye = document.getElementById(eyeId);
  if (input.type === 'password') {
    input.type = 'text';
    eye.classList.replace('bi-eye-slash', 'bi-eye');
  } else {
    input.type = 'password';
    eye.classList.replace('bi-eye', 'bi-eye-slash');
  }
}


  function toggleNovaSenha(inputId, eyeId) {
    const input = document.getElementById(inputId);
    const eye = document.getElementById(eyeId);
    if (input.type === 'password') {
      input.type = 'text';
      eye.classList.replace('bi-eye-slash', 'bi-eye');
    } else {
      input.type = 'password';
      eye.classList.replace('bi-eye', 'bi-eye-slash');
    }
  }


    function validarFormulario() {
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const submitBtn = document.getElementById('submit-btn');
      submitBtn.disabled = !(email && password);
    }

    function mostrarRedefinicaoSenha() {
      document.getElementById('redefinir-senha-form').classList.remove('d-none');
      document.getElementById('login-form').classList.add('d-none');
    }

    function voltarLogin() {
      document.getElementById('redefinir-senha-form').classList.add('d-none');
      document.getElementById('login-form').classList.remove('d-none');
    }

    function validarRedefinicaoSenha() {
      const resetEmail = document.getElementById('reset-email').value;
      const resetBtn = document.getElementById('reset-btn');
      resetBtn.disabled = !resetEmail;
    }

    document.getElementById('reset-btn').onclick = async function(e) {
      e.preventDefault();
      const email = document.getElementById('reset-email').value;
      const res = await fetch('/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.text();
      let msg = '';
      try { msg = JSON.parse(data).message; } catch { msg = data; }
      Swal.fire('Redefinição de Senha', msg, 'info');
    };

    window.onload = function() {
      const params = new URLSearchParams(window.location.search);
      const token = params.get('token');
      if (token) {
        document.getElementById('login-form').classList.add('d-none');
        document.getElementById('redefinir-senha-form').classList.add('d-none');
        document.getElementById('nova-senha-area').classList.remove('d-none');
        window.tokenResetSenha = token;
      }
    };

document.getElementById('login-form').addEventListener('submit', async function(e) {
  e.preventDefault();

  const email = document.getElementById('email').value;
  const password = document.getElementById('password').value;

  try {
    const res = await fetch('/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });

    if (res.ok) {
      Swal.fire({
        title: 'Login bem-sucedido!',
        text: 'Redirecionando...',
        icon: 'success',
        timer: 2000,
        showConfirmButton: false
      }).then(() => {
        window.location.href = '/dashboard'; // ajuste o caminho se necessário
      });
    } else if (res.status === 401) {
      Swal.fire({
        icon: 'error',
        title: 'Acesso negado',
        text: 'E-mail ou senha incorretos.'
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Erro',
        text: 'Algo deu errado. Tente novamente mais tarde.'
      });
    }
  } catch (err) {
    Swal.fire({
      icon: 'error',
      title: 'Erro de conexão',
      text: 'Não foi possível conectar ao servidor.'
    });
  }
});


    document.getElementById('reset-pass-btn').onclick = async function(e) {
      if (!window.tokenResetSenha) return;
      e.preventDefault();
      const senha = document.getElementById('nova-senha').value;
      const senhaConf = document.getElementById('nova-senha-conf').value;
      const token = window.tokenResetSenha;

      const senhaForte = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]).{8,}$/;
      if (!senhaForte.test(senha)) {
        return Swal.fire('Erro', 'A nova senha deve ter pelo menos 8 caracteres, incluindo letra maiúscula, minúscula, número e símbolo.', 'error');
      }
      if (senha !== senhaConf) {
        return Swal.fire('Erro', 'As senhas não coincidem.', 'error');
      }

      const res = await fetch('/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password: senha, passwordConfirm: senhaConf })
      });
      const data = await res.text();
      let msg = '';
      try { msg = JSON.parse(data).message; } catch { msg = data; }
      Swal.fire('Senha Redefinida', msg, 'success').then(() => window.location = '/');
    };
  </script>
  <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
</body>
</html>
