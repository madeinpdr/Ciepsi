<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="dashboard.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <title>Dashboard</title>
</head>

<body>
  <div class="sidebar">
    <ul>
      <li><a href="#"><span class="bi bi-calendar-week"></span><span class="label">Agendamento</span></a></li>
      <li><a href="/testes"><span class="bi bi-inboxes-fill"></span><span class="label">Estoque</span></a></li>
      <li><a href="/"><span class="bi bi-box-arrow-left"></span><span class="label">Sair</span></a></li>
    </ul>
  </div>

  <div class="main">
    <header>
      <div class="topbar">


        <div class="dropdown-container">
          <img src="/img/Romis.png" alt="Usuário" class="profile-img" id="profileImg" />

          <div class="dropdown-menu" id="dropdownMenu">
            <button class="dropdown-item" id="ProfileBtn">Meu Perfil</button>
          </div>
        </div>



      </div>
    </header>

    {{!-- Calendario abaixo --}}

    <div class="centro">
      <div class="container">

        <div class="card calendario-card">
          <div class="header">
            <button id="prev-mes">⬅</button>
            <h2 id="mes-atual">Mês</h2>
            <button id="next-mes">➡</button>
          </div>
          <div class="dias-semana">
            <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span>
          </div>
          <div id="dias"></div>
        </div>


        <div class="card form-card">
          <h3>Marcar Consulta</h3>
          <label>Selecione uma data</label>
          <input type="date" id="data-consulta">
          <label>Selecione o horário</label>
          <input type="time" id="hora-consulta">
          <input type="text" id="paciente" placeholder="Nome do paciente">
          <textarea id="descricao" placeholder="Descrição da consulta"></textarea>
          <button id="salvar">Salvar</button>
        </div>

        <div class="card form-card">
          <h4>Consultas do dia:</h4>
          <ul id="lista-consultas" style="max-height: 327px; overflow-y: auto; padding-right: 8px; margin-top: 10px;">
          </ul>
        </div>

        <div id="confirmModal" class="modal-overlay">
          <div class="modal-box">
            <p>Tem certeza que deseja remover esta consulta?</p>
            <div class="modal-buttons">
              <button id="confirmYes" class="btn btn-confirm">Sim</button>
              <button id="confirmNo" class="btn btn-cancel">Cancelar</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/jsCalendario.js"></script>
</body>

</html>