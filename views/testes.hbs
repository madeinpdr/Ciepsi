<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Controle de Testes Psicológicos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="/css/testes.css" rel="stylesheet"/>
</head>
<body class="bg-light">

  <div class="container py-4">
    
    <!-- Botão Voltar com seta -->
    <div class="mb-3">
      <a href="/dashboard" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i> Voltar
      </a>
    </div>
    
    <h1 class="text-center">Controle de Estoque de Testes</h1>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <form method="get" action="/testes" class="d-flex flex-grow-1 me-2">
        <input type="text" class="form-control me-2" name="busca" placeholder="Buscar teste..." value="{{busca}}" />
        <button class="btn btn-primary" type="submit">Buscar</button>
      </form>

      <form method="post" action="/testes/teste/adicionar" class="d-flex gap-2">
        <input type="text" name="nome" class="form-control" placeholder="Nome do teste" required />
        <input type="number" name="quantidade" class="form-control" placeholder="Qtd." min="1" max="500" required />
        <select name="armario" class="form-select" required>
          <option value="">Armário</option>
          {{#each armariosDisponiveis}}
            <option value="{{id}}">Armário {{id}} - {{nome}}</option>
          {{/each}}
        </select>
        <button type="submit" class="btn btn-success">+</button>
      </form>
    </div>

    {{#if nenhumResultado}}
      <div class="alert alert-warning text-center">Nenhum teste encontrado com esse nome.</div>
    {{/if}}

    <div class="d-flex justify-content-between mb-2">
      <button class="btn btn-outline-secondary" onclick="scrollArmarios(-1)">◀</button>
      <button class="btn btn-outline-secondary" onclick="scrollArmarios(1)">▶</button>
    </div>

    <div class="scroll-container d-flex overflow-auto gap-3 pb-3">
      {{#each armarios}}
        <div class="card flex-shrink-0 shadow armario-card">
          <div class="card-header bg-primary text-white">
            {{#if (eq @index 0)}}Armário 1: Personalidade
            {{else if (eq @index 1)}}Armário 2: Atenção e Memória
            {{else if (eq @index 2)}}Armário 3: Inteligência<br /><small>Porta 3: Inteligência Geral</small>
            {{else if (eq @index 3)}}Armário 4: Raciocínio<br /><small>Porta 4: Raciocínio Lógico</small>
            {{else if (eq @index 4)}}Armário 5: Habilidades Específicas
            {{else if (eq @index 5)}}Armário 6: Aptidões
            {{else if (eq @index 6)}}Armário 7: Neuropsicológicos
            {{else if (eq @index 7)}}Armário 8: Psicomotricidade
            {{else if (eq @index 8)}}Armário 9: Projetivos
            {{else if (eq @index 9)}}Armário 10: Infantis
            {{else if (eq @index 10)}}Armário 11: Baterias Compostas
            {{else if (eq @index 11)}}Armário 12: Outros
            {{else}}Armário {{@index}}
            {{/if}}
          </div>
          <ul class="list-group list-group-flush">
            {{#each this.testes}}
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <strong>{{nome}}</strong><br />
                  <small>Quantidade: {{quantidade}}</small>
                </div>
                <div class="btn-group" role="group">
                  <form method="post" action="/testes/teste/{{id}}/adicionar" class="d-inline">
                    <input type="hidden" name="quantidade" value="1" />
                    <button class="btn btn-success btn-sm">+1</button>
                  </form>
                  <form method="post" action="/testes/teste/{{id}}/retirar" class="d-inline">
                    <button class="btn btn-warning btn-sm">-1</button>
                  </form>
                  <form method="post" action="/testes/teste/{{id}}/excluir" class="d-inline" onsubmit="return confirm('Deseja excluir este teste?');">
                    <button class="btn btn-danger btn-sm">Excluir</button>
                  </form>
                </div>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/each}}
    </div>
  </div>

  <script>
    function scrollArmarios(direction) {
      const container = document.querySelector('.scroll-container');
      const scrollAmount = 400;
      container.scrollBy({ left: scrollAmount * direction, behavior: 'smooth' });
    }
  </script>
</body>
</html>
